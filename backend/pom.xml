<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.sankar</groupId>
    <artifactId>dns-filter</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>
    <name>DNS Filter - mini Pi-hole</name>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- JSON for the dashboard REST API (the only runtime dependency) -->
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.11.0</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <!-- The JDK HttpServer reads these once per JVM, when the FIRST server is created.
                         Tests that start a plain HttpServer (BlocklistTest) can run before ApiServerTest,
                         so set them for the whole test JVM up front; otherwise the result depends on
                         test order (it hung on Linux CI). maxReqTime is short to keep tests fast. -->
                    <systemPropertyVariables>
                        <jdk.httpserver.maxConnections>100</jdk.httpserver.maxConnections>
                        <sun.net.httpserver.maxReqTime>2</sun.net.httpserver.maxReqTime>
                        <sun.net.httpserver.maxRspTime>30</sun.net.httpserver.maxRspTime>
                        <sun.net.httpserver.idleInterval>30</sun.net.httpserver.idleInterval>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <!-- Builds a single runnable jar: java -jar target/dns-filter.jar -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.3</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <finalName>dns-filter</finalName>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>com.sankar.dnsfilter.Main</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
